[Unit]
Description=OpenClaw Scheduler and Loop Worker
After=network-online.target openclaw-runtime.service
Wants=network-online.target
Requires=openclaw-runtime.service
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/openclaw
EnvironmentFile=/opt/openclaw/.env
ExecStart=/opt/openclaw/venv/bin/python -m app.scheduler_main
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
